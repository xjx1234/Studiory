# ─────────────────────────────────────────────────────────────────────────────
# API 脚手架配置模板
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按实际环境填写各项值
#   3. .env 已加入 .gitignore，请勿提交到版本控制
# ─────────────────────────────────────────────────────────────────────────────

# ── 服务 ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production | test
SERVER_ADDR=:8080             # HTTP 监听地址
# SERVER_READ_HEADER_TIMEOUT=5s   # 读取请求头超时（防 Slowloris）
# SERVER_READ_TIMEOUT=15s         # 读取完整请求（含 body）
# SERVER_WRITE_TIMEOUT=30s        # 写入响应超时
# SERVER_IDLE_TIMEOUT=120s        # keep-alive 空闲连接超时

# ── PostgreSQL（方式一：完整 DSN，优先）────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/app?sslmode=disable

# ── PostgreSQL（方式二：分项配置，DATABASE_URL 为空时生效）──────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=app
# DB_SSL_MODE=disable         # disable | require | verify-full
# DB_MAX_CONNS=20             # 最大连接数
# DB_MIN_CONNS=2              # 最小空闲连接数
# DB_MAX_CONN_IDLE=10m        # 空闲连接最大存活时间（Go duration 格式）
# DB_MAX_CONN_LIFE=1h         # 连接最大存活时间

# ── Redis（方式一：完整 URL，优先）────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Redis（方式二：分项配置，REDIS_URL 为空时生效）────────────────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_POOL_SIZE=10          # 连接池大小
REDIS_KEY_PREFIX=app          # Redis 业务键前缀，避免多项目共用 Redis 时冲突

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production   # 生产环境务必使用强随机字符串
JWT_ACCESS_TTL=2h             # Access Token 有效期（Go duration 格式）
JWT_REFRESH_TTL=168h          # Refresh Token 有效期（7天）

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_MOCK_CODE_ENABLED=true   # 仅开发环境启用固定验证码 123456，生产环境必须为 false
AUTH_MULTI_DEVICE_ENABLED=true  # true=多设备同时在线；false=单设备（新登录踢掉旧会话）
AUTH_REDIS_FAIL_OPEN=true       # Redis故障时鉴权策略：true=放行（可用性优先）；false=拒绝（安全性优先）

# ── SMTP（验证码邮件下发，可选）──────────────────────────────────────────────────
# host 为空则不启用邮件下发，回退到 mock。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@example.com

# ── OAuth ─────────────────────────────────────────────────────────────────────
OAUTH_DEV_MODE=true           # 开发模式：直接用 provider + open_id 登录；生产必须为 false
OAUTH_PROVIDERS=wechat,apple,google

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=console            # console（彩色）| json（生产推荐）

# ── 限流 ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120     # 未登录/公开路由：每 IP 每分钟最大请求数
RATE_LIMIT_USER_PER_MINUTE=120  # 已鉴权 /user、/admin：每 user_id 每分钟最大请求数

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
