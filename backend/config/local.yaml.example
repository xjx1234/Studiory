# ─────────────────────────────────────────────────────────────────────────────
# 本地私有配置模板（复制为 local.yaml 后填写真实值）
# local.yaml 已加入 .gitignore，不会提交到版本控制
# ─────────────────────────────────────────────────────────────────────────────

database:
  password: your_postgres_password

redis:
  password: ""               # 本地 Redis 通常无密码
  key_prefix: app

jwt:
  secret: "your-local-dev-secret-at-least-32-chars"

auth:
  mock_code_enabled: true
  multi_device_enabled: true   # false=单设备，新登录踢掉旧会话

oauth:
  dev_mode: true
  providers:
    - wechat
    - apple
    - google
  wechat:
    app_id: ""
    app_secret: ""
  apple:
    client_id: ""
  google:
    client_id: ""

cors:
  allow_origins:
    - "http://localhost:5173"
    - "http://localhost:3000"
